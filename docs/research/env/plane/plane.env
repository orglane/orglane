# Variables for Plane Community Edition v1.4.3 (upstream compose:
# deployments/cli/community/docker-compose.yml at the v1.4.3 tag). Local only.
APP_RELEASE=v1.4.3
APP_DOMAIN=localhost
LISTEN_HTTP_PORT=18102
LISTEN_HTTPS_PORT=18443
WEB_URL=http://localhost:18102
CORS_ALLOWED_ORIGINS=http://localhost:18102
SECRET_KEY=research-only-not-a-secret-0123456789abcdef
LIVE_SERVER_SECRET_KEY=research-only-not-a-secret-0123456789
# Raised from the default 60/minute so the load test is not throttled.
API_KEY_RATE_LIMIT=100000/minute

CERT_EMAIL=
CERT_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
SITE_ADDRESS=:80
