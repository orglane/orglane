# Local mode (--demo on a laptop): Traefik serves plain HTTP on localhost, so
# the workspace URL is http://, which the core only allows in development.
# Selected by ORGLANE_INGRESS_MODE=local (the default); see compose.yaml.
ORGLANE_INGRESS_MODE=local
ORGLANE_ENVIRONMENT=development
ORGLANE_DOMAIN_SCHEME=http
