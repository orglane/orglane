# Copy to .env next to compose.yaml and adjust. The install script
# (deploy/install.sh) writes this file for you. Never commit .env: it holds
# the database password.

# Required. Use a random hex string, e.g. `openssl rand -hex 32` (no URL
# special characters: it becomes part of the database URL).
ORGLANE_POSTGRES_PASSWORD=

# Required. Encrypts the signing keys at rest: at least 32 random characters,
# e.g. `openssl rand -base64 32`. Never change it on a running instance.
ORGLANE_IDENTITY_MASTER_SECRET=

# Where persistent data lives on the host (PostgreSQL, certificates).
# On macOS use a real path without symlinks under your home directory, e.g.
# /Users/you/orglane-data (Docker Desktop cannot share /var/lib).
ORGLANE_DATA_DIR=/var/lib/orglane

# Core image. Releases pin a version (#10); `make image` builds orglane:dev.
# ORGLANE_IMAGE=ghcr.io/orglane/orglane:latest

# --- Local mode (default): plain HTTP on http://localhost, no domain --------
# The mode selects modes/<mode>.env (environment, workspace URL scheme).
ORGLANE_INGRESS_MODE=local
ORGLANE_DOMAIN_BASE=localhost
# Published on localhost only. To use another port, e.g. 8000, set
# ORGLANE_HTTP_PUBLISH=127.0.0.1:8000 and ORGLANE_DOMAIN_WORKSPACE_HOST=localhost:8000.
ORGLANE_HTTP_PUBLISH=127.0.0.1:80
ORGLANE_HTTPS_PUBLISH=127.0.0.1:443

# Demo mode: load the "Acme Robotics" demo dataset into an empty database and
# allow one-click sign-in as any demo person. Local mode only.
# ORGLANE_DEMO_ENABLED=true

# --- Domain mode: HTTPS with Let's Encrypt ----------------------------------
# Point DNS for the workspace host at this server and open ports 80 and 443.
# ORGLANE_INGRESS_MODE=domain
# ORGLANE_DOMAIN_BASE=acme.com
# ORGLANE_DOMAIN_WORKSPACE_HOST=work.acme.com
# ORGLANE_ACME_EMAIL=admin@acme.com
# ORGLANE_HTTP_PUBLISH=80
# ORGLANE_HTTPS_PUBLISH=443
# Let's Encrypt staging, for a first try without hitting rate limits:
# ORGLANE_ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Managed services (off by default; docs/specs/agent.md) ------------------
# The agent installs services such as Forgejo; it is the only container with
# the Docker socket. `install.sh enable-managed` sets all of this. By hand:
# ORGLANE_AGENT_SECRET is shared by the core and the agent: 64 random hex
# characters, e.g. `openssl rand -hex 32`. Empty disables managed services.
# ORGLANE_AGENT_SECRET=
# COMPOSE_PROFILES=managed
# The agent image, pinned by digest and of the same version as the core:
# ORGLANE_AGENT_IMAGE=ghcr.io/orglane/orglane-agent:<version>@sha256:<digest>
# Where service ports (Forgejo SSH) are published: 0.0.0.0 in domain mode.
# ORGLANE_AGENT_PUBLISH_ADDRESS=127.0.0.1
# In local mode managed services need a workspace name other than localhost:
# ORGLANE_DOMAIN_BASE=orglane.localhost
# The workspace host without a port, if it has one (Traefik's alias for the
# services): ORGLANE_EDGE_WORKSPACE_ALIAS=orglane.localhost

# --- Networking ---------------------------------------------------------------
# The Traefik <-> core network is <prefix>.0/24, with Traefik at <prefix>.2
# (the only proxy the core trusts for client addresses). Change the prefix if
# it collides with a network of the host.
# ORGLANE_EDGE_NETWORK_PREFIX=10.231.0

# --- PostgreSQL sizing (ADR 0009) -------------------------------------------
# Light defaults for a small host. See deploy/README.md for the sizing rules.
# ORGLANE_POSTGRES_SHARED_BUFFERS=128MB
# ORGLANE_POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
# ORGLANE_POSTGRES_WORK_MEM=4MB
# ORGLANE_POSTGRES_MAINTENANCE_WORK_MEM=64MB
# ORGLANE_POSTGRES_MAX_CONNECTIONS=50

# --- Logging -------------------------------------------------------------------
# ORGLANE_LOG_LEVEL=info
# ORGLANE_TRAEFIK_LOG_LEVEL=INFO
