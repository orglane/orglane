{{define "content"}}<h1 style="margin:0 0 16px;font-size:22px;line-height:1.3;">{{t "invitation.greeting" "name" .D.Name}}</h1>
<p style="margin:0 0 16px;">{{t "invitation.intro" "inviter" .D.Inviter "workspace" .Workspace}}</p>
<p style="margin:0 0 24px;">{{t "invitation.workEmail" "workEmail" .D.WorkEmail}}</p>
<p style="margin:0 0 24px;"><a href="{{.D.Link}}" style="display:inline-block;background:#4338ca;color:#ffffff;text-decoration:none;font-weight:600;padding:12px 20px;border-radius:8px;">{{t "invitation.action"}}</a></p>
<p style="margin:0 0 8px;color:#3f3f46;font-size:14px;">{{t "invitation.linkFallback"}}</p>
<p style="margin:0 0 24px;font-size:14px;word-break:break-all;"><a href="{{.D.Link}}" style="color:#4338ca;">{{.D.Link}}</a></p>
<p style="margin:0 0 8px;color:#3f3f46;font-size:14px;">{{tn "invitation.expiry" .D.Days "days" .D.Days}}</p>
<p style="margin:0;color:#3f3f46;font-size:14px;">{{t "invitation.ignore"}}</p>
{{end}}
