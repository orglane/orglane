{
  "name": "@orglane/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client and React Query hooks for the Orglane API, generated from the OpenAPI contract.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-generate": "node codegen/generate.mjs --check",
    "generate": "node codegen/generate.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.80.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "5.105.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
