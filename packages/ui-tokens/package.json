{
  "name": "@orglane/ui-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Orglane design tokens shared by the web and mobile apps.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "files": [
    "dist",
    "tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-generate": "node scripts/generate-css.ts --check",
    "generate": "node scripts/generate-css.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
