# Build output
/bin/
# `go build ./tools/ci/` (or ./core/cmd/orglane) in the repository root
/ci
/orglane
dist/
# web/dist is embedded into the binary (go:embed) and must exist before the
# first build; only its placeholder is committed.
!/web/dist/
/web/dist/*
!/web/dist/.gitkeep
/web/test-results/
/web/playwright-report/

# Pinned developer tools installed by `make bootstrap`
/.bin/

# Dependencies
node_modules/

# Test and coverage output
coverage/
*.out

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Local environment
.env
.env.*
!.env.example

# OpenID Conformance Suite runs (make conformance)
/.conformance/

# PR review evidence is uploaded to GitHub, never committed.
/.github/pr-assets/
/docs/screenshots/
