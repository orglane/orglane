---
// Small line icons for the feature list (drawn for this site). Decorative.
interface Props {
  name: "app" | "identity" | "integration" | "hosting" | "extension";
}
const { name } = Astro.props;
---

<svg class="feature__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {
    name === "app" && (
      <>
        <rect x="6.5" y="2.75" width="11" height="18.5" rx="2.75" />
        <path d="M10.5 17.75h3" />
      </>
    )
  }
  {
    name === "identity" && (
      <>
        <circle cx="12" cy="8.5" r="3.75" />
        <path d="M4.75 20.25c1.4-3.4 4-5.25 7.25-5.25s5.85 1.85 7.25 5.25" />
      </>
    )
  }
  {
    name === "integration" && (
      <>
        <circle cx="5.75" cy="6" r="2.5" />
        <circle cx="18.25" cy="6" r="2.5" />
        <circle cx="12" cy="18" r="2.5" />
        <path d="M8.25 6h7.5M7 8.25l3.75 7.5M17 8.25l-3.75 7.5" />
      </>
    )
  }
  {
    name === "hosting" && (
      <>
        <rect x="3.75" y="3.75" width="16.5" height="7" rx="2" />
        <rect x="3.75" y="13.25" width="16.5" height="7" rx="2" />
        <path d="M7.5 7.25h.01M7.5 16.75h.01M11 7.25h5.5M11 16.75h5.5" />
      </>
    )
  }
  {
    name === "extension" && (
      <>
        <path d="M8.5 6.5 3 12l5.5 5.5M15.5 6.5 21 12l-5.5 5.5" />
        <path d="m13.25 4.75-2.5 14.5" />
      </>
    )
  }
</svg>
